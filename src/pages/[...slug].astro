---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionNav from '@/components/SectionNav.astro';
import CTASection from '@/components/CTASection.astro';
import { pages, type SitePage } from '@/data/pages';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: SitePage };
const parent = page.slug.startsWith('platform/') ? { label: 'Platform', href: '/platform/' } : { label: 'Solutions', href: '/solutions/' };
---
<BaseLayout title={page.title} description={page.description}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, parent, { label: page.title }]} />
  <PageHero eyebrow={page.eyebrow} title={page.title} intro={page.intro} tone={page.tone || 'paper'}>
    <div class="button-row"><a class="button" href="/contact/?path=build">Build a Portal</a><a class="text-link" href="/principles/">Read our principles →</a></div>
  </PageHero>
  <SectionNav items={page.sections.map((section) => ({ id: section.id, label: section.title }))} />
  {page.sections.map((section) => (
    <section class="content-section" id={section.id}>
      <h2>{section.title}</h2>
      <div class="content-prose">
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        {section.callout && <aside class="callout"><strong>Design note</strong>{section.callout}</aside>}
      </div>
    </section>
  ))}
  {page.related && <section class="section-shell"><div class="section-heading"><p class="eyebrow">Continue exploring</p><h2>See the wider picture.</h2></div><div class="card-grid">{page.related.map((item) => <a class="card" href={item.href}><p class="eyebrow">Related</p><h3>{item.label}</h3><span aria-hidden="true">↗</span></a>)}</div></section>}
  <CTASection />
</BaseLayout>
