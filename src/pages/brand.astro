---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import CTASection from '@/components/CTASection.astro';
const colours = [['Paper','#F3F0E8'],['Ink','#171916'],['Civic blue','#1B4DFF'],['Vermillion','#F24D2E'],['Signal lime','#C9FF3D']];
---
<BaseLayout title="Brand" description="Portal Page brand principles, descriptions, name, palette and guidance for press and partners.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Brand' }]} />
  <PageHero eyebrow="Brand" title="A doorway into a shared digital place." intro="Portal Page's identity combines editorial clarity, civic optimism and visible boundaries. This page provides working brand guidance until final downloadable assets are approved." tone="paper" />
  <section class="content-section"><h2>The name.</h2><div class="content-prose"><p>A portal is an entrance: a recognisable threshold between spaces. A page is a place where information can be read, considered and returned to. Together, Portal Page describes a digital front door for a community.</p><p>Use the full name “Portal Page” in prose. Do not shorten it to “Portal” where confusion could result. The working tagline is <strong>Your community. Your platform. Your data.</strong></p><p>The abstract mark uses three offset openings to suggest different people entering a shared space. The coloured centre expresses the active community boundary.</p></div></section>
  <section class="content-section"><h2>Press description.</h2><div class="content-prose"><h3>Short</h3><p>Portal Page is a privacy-first technology company that creates private digital community platforms for organisations, businesses and governments.</p><h3>Long</h3><p>Portal Page builds private digital spaces where organisations and the people they serve can communicate, share information and build stronger communities from one trusted place. Its product direction is based on privacy, data minimisation, transparency, portability and organisational control. Portal Page intends to earn revenue from organisations buying useful software—not from behavioural advertising built around community participation.</p><p>These descriptions should not be expanded with customer, location, founder, funding or certification details until those facts are verified.</p></div></section>
  <section class="section-shell"><div class="section-heading"><p class="eyebrow">Working palette</p><h2>Calm foundation. Civic signals.</h2></div><div class="fact-strip">{colours.slice(0,4).map(([name, hex]) => <div style={`background:${hex};color:${name === 'Ink' || name === 'Civic blue' ? 'white' : 'black'};min-height:10rem`}><strong>{name}</strong><span>{hex}</span></div>)}</div><div style="background:#C9FF3D;padding:1.5rem;min-height:10rem"><strong style="font:400 2.3rem/1 var(--serif)">Signal lime</strong><span style="display:block;font:.7rem var(--mono)">#C9FF3D</span></div></section>
  <section class="content-section"><h2>Use with care.</h2><div class="content-prose"><ul><li>Preserve clear space around the wordmark and symbol.</li><li>Keep the name legible and the palette accessible.</li><li>Do not imply endorsement, partnership or customer status without permission.</li><li>Do not place the identity beside invented certification marks or unsupported claims.</li><li>Request approved vector and raster files before external publication; this website mark is a working implementation.</li></ul></div></section>
  <CTASection title="Need brand or press information?" text="Use the partnerships or general enquiry pathway and describe the intended context." />
</BaseLayout>
