---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import ArticleEnd from '@/components/ArticleEnd.astro';
export async function getStaticPaths() {
  const entries = await getCollection('insights', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}
const { entry, all } = Astro.props as { entry: CollectionEntry<'insights'>; all: CollectionEntry<'insights'>[] };
const { Content, headings } = await render(entry);
const words = (entry.body ?? '').split(/\s+/).length;
const related = all.filter(item => item.id !== entry.id && (item.data.category === entry.data.category || item.data.tags.some(tag => entry.data.tags.includes(tag)))).slice(0,3);
const schema = { '@context':'https://schema.org', '@type':'Article', headline:entry.data.title, description:entry.data.description, datePublished:entry.data.publishedDate.toISOString(), dateModified:(entry.data.updatedDate || entry.data.publishedDate).toISOString(), author:{'@type':'Organization',name:entry.data.author}, publisher:{'@type':'Organization',name:'Portal Page'}, mainEntityOfPage:new URL(Astro.url.pathname, Astro.site) };
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article" publishedDate={entry.data.publishedDate} updatedDate={entry.data.updatedDate} image={entry.data.image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Insights',href:'/insights/'},{label:entry.data.title}]} />
  <header class="article-header"><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p><div class="article-meta"><span>{entry.data.author}</span><time datetime={entry.data.publishedDate.toISOString()}>{entry.data.publishedDate.toLocaleDateString('en-AU',{dateStyle:'long'})}</time>{entry.data.updatedDate && <span>Updated {entry.data.updatedDate.toLocaleDateString('en-AU',{dateStyle:'medium'})}</span>}<span>{Math.max(4, Math.round(words/220))} minute read</span></div></header>
  <div class="article-layout"><aside class="article-toc"><strong>In this article</strong>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</aside><article class="article-body"><Content /><ArticleEnd title={entry.data.title} url={Astro.url.pathname} author={entry.data.author} /></article></div>
  {related.length > 0 && <section class="section-shell related"><div class="section-heading"><p class="eyebrow">Related insights</p><h2>Keep exploring.</h2></div><div class="card-grid">{related.map(item => <a class="card" href={`/insights/${item.id}/`}><p class="eyebrow">{item.data.category}</p><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></section>}
  <CTASection />
</BaseLayout>
