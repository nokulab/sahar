---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import { site } from '@/data/site';
---
<BaseLayout title="Contact" description="Talk to Portal Page about building a private community portal for your organisation, government program, partnership or project.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
  <PageHero eyebrow="Contact" title="Tell us about the community." intro="Who needs a better place to communicate? What is scattered today? Which responsibilities and boundaries matter most?" tone="lime" />
  <section class="contact-layout">
    <aside><p class="eyebrow">Choose a pathway</p><div class="contact-paths"><a href="?path=build#contact-form" data-contact-path="build">Build a Portal ↘</a><a href="?path=support#contact-form" data-contact-path="support">Support ↘</a><a href="?path=partnerships#contact-form" data-contact-path="partnerships">Partnerships ↘</a><a href="?path=general#contact-form" data-contact-path="general">General enquiries ↘</a></div>{site.email ? <p>Prefer email?<br /><a href={`mailto:${site.email}`}>{site.email}</a></p> : <p class="form-note">A public contact email has not yet been configured.</p>}</aside>
    <div>
      {!site.email && <div class="legal-notice" style="margin-bottom:2rem">The enquiry email address has not been configured yet. You can still create a draft, then add the recipient in your email app.</div>}
      <form class="contact-form" id="contact-form" data-recipient={site.email}>
        <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="email">Work email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="organisation">Organisation</label><input id="organisation" name="organisation" autocomplete="organization" /></div>
        <div class="field"><label for="path">What would you like to discuss?</label><select id="path" name="path" required><option value="">Select one</option><option value="build">Build a Portal</option><option value="support">Support</option><option value="partnerships">Partnerships</option><option value="general">General enquiry</option></select></div>
        <div class="field"><label for="message">Tell us about the community</label><textarea id="message" name="message" maxlength="2000" required></textarea></div>
        <label style="display:flex;align-items:start;gap:.6rem"><input type="checkbox" name="privacy_acknowledgement" required style="margin-top:.35rem" /> <span>I understand this creates a draft in my email app. Nothing is sent until I review the draft and press Send. Read the <a href="/privacy/">draft privacy notice</a>.</span></label>
        <button class="button" type="submit">Create email draft</button>
        <p class="form-note">Do not include sensitive personal information. Your entries stay in this browser page until they are passed to your email app; this website does not submit them to a form provider.</p>
        <p class="form-note" id="email-draft-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const pathSelect = document.querySelector<HTMLSelectElement>('#path');
    const status = document.querySelector<HTMLElement>('#email-draft-status');
    const allowedPaths = new Set(['build', 'support', 'partnerships', 'general']);

    const selectPath = (path: string | null) => {
      const normalizedPath = path === 'government' ? 'support' : path;
      if (pathSelect && normalizedPath && allowedPaths.has(normalizedPath)) pathSelect.value = normalizedPath;
    };

    selectPath(new URLSearchParams(window.location.search).get('path'));

    document.querySelectorAll<HTMLAnchorElement>('[data-contact-path]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        selectPath(link.dataset.contactPath ?? null);
        form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        pathSelect?.focus({ preventScroll: true });
      });
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const pathLabel = pathSelect?.selectedOptions[0]?.textContent?.trim() || 'General enquiry';
      const organisation = String(data.get('organisation') || '').trim();
      const subject = pathLabel;
      const source = new URL(window.location.href);
      source.hash = '';
      source.search = '';
      const body = [
        'Portal Page enquiry',
        '',
        `Name: ${String(data.get('name') || '').trim()}`,
        `Email: ${String(data.get('email') || '').trim()}`,
        `Organisation: ${organisation || 'Not provided'}`,
        `Enquiry type: ${pathLabel}`,
        '',
        'Community details:',
        String(data.get('message') || '').trim(),
        '',
        `Created from: ${source.toString()}`
      ].join('\n');
      const recipient = form.dataset.recipient?.trim() || '';
      const mailto = `mailto:${encodeURIComponent(recipient)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (status) {
        status.textContent = recipient
          ? 'Your email app should open with a draft. Review it, then press Send.'
          : 'Your email app should open with a draft. Add the recipient, review it, then press Send.';
        status.hidden = false;
      }

      window.location.href = mailto;
    });
  </script>
</BaseLayout>
