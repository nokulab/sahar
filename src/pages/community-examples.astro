---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import CTASection from '@/components/CTASection.astro';
const examples = [
  { title: 'A 250-apartment residential building', text: 'Residents currently receive emails from several senders, search a shared drive for documents and use an unofficial social group for local questions. An illustrative portal could bring together verified building announcements, moving information, current guides, events, resident-selected directory details and clear request pathways.', needs: ['Separate committee, manager and resident publishing roles', 'Privacy-conscious member directory defaults', 'Clear boundary between emergency and routine communication', 'Departure process when residents move'] },
  { title: 'A regional council program', text: 'A multi-year regional program works with a defined reference group spread across several towns. An illustrative portal could provide background documents, meeting information, topic discussions, updates and a stable record of resources between workshops.', needs: ['Accessibility and low-bandwidth participation', 'Explicit distinction from statutory consultation', 'Council information-management assessment', 'Alternative channels for people unable to use the portal'] },
  { title: 'A national professional association', text: 'Members want to exchange practice knowledge, find chapter events and access maintained resources without relying on a consumer social network. An illustrative portal could organise chapter spaces, expert discussions, event information, member-controlled profiles and association announcements.', needs: ['Membership system and identity lifecycle', 'Professional standards and moderation', 'Branch and national permissions', 'Guidance for turning useful discussion into maintained knowledge'] },
  { title: 'An employee community of practice', text: 'People in the same discipline work across locations and business units. An illustrative portal could provide questions, working notes, events, shared guides and voluntary member profiles while keeping community participation separate from performance monitoring.', needs: ['Clear employment and HR boundaries', 'Voluntary participation and psychological safety', 'Identity changes when roles move', 'Measures tied to useful outcomes rather than activity surveillance'] }
];
---
<BaseLayout title="Community examples" description="Four clearly labelled hypothetical Portal Page scenarios for residential, government, association and employee communities.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Community examples' }]} />
  <PageHero eyebrow="Illustrative scenarios—not customer case studies" title="Imagine a community with a place of its own." intro="These hypothetical examples show how different organisations could think about a Portal Page. They do not describe existing customers, deployments or confirmed features." tone="lime" />
  <div class="legal-notice">Every scenario below is fictional and provided for illustration only.</div>
  {examples.map((example, i) => <section class="content-section"><h2>{String(i + 1).padStart(2, '0')}. {example.title}</h2><div class="content-prose"><p>{example.text}</p><h3>Questions to resolve</h3><ul>{example.needs.map((need) => <li>{need}</li>)}</ul><p>Final capability, responsibilities and obligations would be confirmed through discovery and appropriate professional review.</p></div></section>)}
  <CTASection title="Turn your real context into a useful blueprint." text="We will start with your people, current channels, operating responsibilities and trust requirements." />
</BaseLayout>
