---
const { title, url, author = 'Portal Page editorial team' } = Astro.props;
const absolute = new URL(url, Astro.site).href;
---
<footer style="margin-top:5rem;padding-top:2rem;border-top:1px solid var(--line)">
  <p class="eyebrow">Written by</p>
  <h2 style="font:400 2.2rem/1 var(--serif);margin-bottom:.7rem">{author}</h2>
  <p>Original guidance from Portal Page for people building, choosing and governing responsible digital communities. Corporate and product claims are reviewed against verified information.</p>
  <div class="button-row" aria-label="Share this article">
    <a class="button button-outline" href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(absolute)}`}>Share by email</a>
    <a class="text-link" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(absolute)}`} rel="noopener noreferrer">Share on LinkedIn ↗</a>
  </div>
</footer>
