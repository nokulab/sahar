---
const { title = 'Give your community a place of its own.', text = 'Tell us who you need to bring together and what a trusted digital home should make possible.' } = Astro.props;
---
<section class="cta-section">
  <p class="eyebrow">Start a conversation</p>
  <h2>{title}</h2>
  <p>{text}</p>
  <div class="button-row"><a class="button button-light" href="/contact/?path=build">Talk to Portal Page</a><a class="text-link text-link-light" href="/principles/">Read our principles <span aria-hidden="true">→</span></a></div>
</section>
